# install.sh copies this to /etc/netwatch.env (root:<service user>, mode 640). Never commit the real one.
# Every setting is explained in docs/DEPLOY.md. Quote values that contain spaces.

# Who gets the emails, and the Gmail account + app password that sends them
# (install.sh copies these from /etc/comcast-monitor.env if isp-outage-monitor is installed)
REPORT_TO=
SMTP_USER=
SMTP_APP_PASSWORD=

# Network interface on the LAN (list them with: ip -br link)
LAN_IFACE=eth0

# Port forwards that are expected (UPnP description prefix, comma-separated); everything else alerts
ALLOWED_FORWARDS=tailscale-portmap

# Optional self-hosted site behind Tailscale Funnel + Caddy
#CADDY_LOG=/var/log/caddy/site-access.log
#SITE_URL=http://127.0.0.1:8000/
#SITE_NAME=website
# Backend unit whose log has ip=... email=... per request: alerts then name the account and its device
#SITE_ACCOUNTS_UNIT=
#MAINT_DIR=

# Tuning (defaults shown)
#ROUTER_IP=192.168.1.1
#UPNP_PORT=5000
#UPNP_DESC_PATH=/Public_UPNP_gatedesc.xml
#HAMMER_REQUESTS=600
#GEO_LOOKUP=on
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#DB_PATH=/var/lib/netwatch/netwatch.db
#OUI_FILE=/usr/share/arp-scan/ieee-oui.txt

# Optional: weekly-summary line saying when a PC last sent its Steam report (isp-outage-monitor pc/ helper)
#PC_REPORT=/var/lib/comcast-monitor/steam.json
#PC_STALE_HOURS=48
